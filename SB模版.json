{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "pk-dns"
      },
      {
        "type": "udp",
        "tag": "ali-dns",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "cf-dns",
        "server": "cloudflare-dns.com",
        "domain_resolver": "ali-dns",
        "detour": "📦 sing-box"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": [
          "SVCB",
          "HTTPS",
          "PTR"
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "cn",
            "invert": true
          },
          {
            "rule_set": "geosite-geolocation-!cn"
          }
        ],
        "server": "cf-dns"
      },
      {
        "rule_set": "cn",
        "server": "ali-dns"
      },
      {
        "server": "fakeip"
      }
    ],
    "final": "ali-dns",
    "strategy": "ipv4_only",
    "timeout": "10s",
    "cache_capacity": 16384,
    "optimistic": {
      "enabled": true,
      "timeout": "5m0s"
    }
  },
  "http_clients": [
    {
      "tag": "default",
      "version": 2,
      "stream_receive_window": 0,
      "connection_receive_window": 0
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "mtu": 1500,
      "address": "30.0.0.1/24",
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true,
      "udp_timeout": "5m0s",
      "udp_nat_max": 4096,
      "stack": "mixed",
      "endpoint_independent_nat": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "selector",
      "tag": "📦 sing-box",
      "outbounds": [
        "🇺🇲 美国Anytls"
      ],
      "default": "🇺🇲 美国Anytls",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "🟢 自动-测速",
      "outbounds": [],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "10m0s",
      "tolerance": 50,
      "idle_timeout": "30m0s"
    },
    {
      "type": "selector",
      "tag": "📠 Telegram",
      "outbounds": [
        "📦 sing-box",
        "🇯🇵 日本Tuic5"
      ],
      "default": "📦 sing-box",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🇨🇳 国内流量",
      "outbounds": [
        "DIRECT",
        "📦 sing-box",
        "❌ REJECT-DROP"
      ],
      "default": "DIRECT",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "📦 sing-box",
        "DIRECT"
      ],
      "default": "📦 sing-box",
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "🚦 FINAL",
      "outbounds": [
        "📦 sing-box",
        "DIRECT",
        "❌ REJECT-DROP"
      ],
      "default": "📦 sing-box",
      "interrupt_exist_connections": true
    },
    {
      "type": "block",
      "tag": "❌ REJECT-DROP"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "icmp",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "cn",
        "invert": true,
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "protocol": [
          "stun",
          "dtls"
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        "port": 993,
        "rule_set": "cnip",
        "action": "reject"
      },
      {
        "protocol": "quic",
        "action": "reject"
      },
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "reject"
      },
      {
        "domain_suffix": "cdn.jsdelivr.net",
        "outbound": "DIRECT"
      },
      {
        "rule_set": [
          "cn",
          "cnip"
        ],
        "outbound": "🇨🇳 国内流量"
      },
      {
        "ip_cidr": [
          "91.105.192.0/23",
          "91.108.4.0/22",
          "91.108.8.0/21",
          "91.108.12.0/22",
          "91.108.16.0/21",
          "91.108.20.0/22",
          "91.108.56.0/22",
          "95.161.64.0/20",
          "149.154.160.0/20",
          "149.154.160.0/21",
          "149.154.168.0/22",
          "149.154.172.0/22",
          "185.76.151.0/24"
        ],
        "outbound": "📠 Telegram"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": [
              "cn",
              "cnip"
            ],
            "invert": true
          },
          {
            "rule_set": "geosite-geolocation-!cn"
          }
        ],
        "outbound": "📦 sing-box"
      },
      {
        "action": "route-options",
        "udp_disable_domain_unmapping": true,
        "udp_connect": true
      },
      {
        "protocol": "ntp",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "直连",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "全局",
        "outbound": "GLOBAL"
      },
      {
        "ip_cidr": "198.18.0.0/15",
        "outbound": "📦 sing-box"
      },
      {
        "outbound": "🚦 FINAL"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": [
          "cn",
          "cnip"
        ],
        "url": "https://cdn.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/{tag}.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        "tag": "Google",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "url": "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "update_interval": "48h0m0s"
      },
      {
        "type": "remote",
        "tag": "geosite-category-ads-all",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-category-ads-all.srs",
        "update_interval": "48h0m0s"
      }
    ],
    "final": "🚦 FINAL",
    "auto_detect_interface": true,
    "default_domain_resolver": "pk-dns",
    "default_http_client": "default"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    }
  }
}